{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-dynamic-page",
    "description": "SPA loading for Meros powered Wordpress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {},
    "autoload": {
        "psr-4": {
            "MM\\Meros\\DynamicPage\\": "src/"
        }
    },
    "extra": {
        "meros": {
            "provider": "MM\\Meros\\DynamicPage\\ServiceProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
